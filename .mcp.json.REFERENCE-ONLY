{
  // MCP Servers — external tool providers
  // This file goes at ~/.claude/.mcp.json
  // Or add servers via CLI: claude mcp add --transport http <name> <url>
  "mcpServers": {
    // Salesforce SE Grounding Service (internal Salesforce only, NOT a kit dependency) — verified product
    // knowledge, competitive intel, field insights. Requires ZScaler VPN + a bearer token.
    // The endpoint is internal and changes; ask in #solutions-ai-tooling for the current URL and token.
    // Provides: grounding_search, grounding_search_narrowed, kg_lookup, kg_traverse
    "salesforce-grounding": {
      "type": "http",
      "url": "INTERNAL-SE-GROUNDING-ENDPOINT-ask-solutions-ai-tooling/mcp"
    },

    // Salesforce Docs MCP — official Trailhead, developer guides, release notes, help articles
    // No auth required, public endpoint
    // Provides: salesforce_docs_search, salesforce_docs_fetch
    // Details: https://labs.agentforce.com/docs/salesforce-docs-mcp
    "salesforce-docs": {
      "type": "http",
      "url": "https://salesforce-docs-76258744c9d7.herokuapp.com/api/mcp"
    }
  }
}
